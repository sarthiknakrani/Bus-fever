# Godot 4+ specific ignores
.godot/
build/
export_presets.cfg
*.translation
*.pot
*.po

# OS specific
.DS_Store
*.DS_Store
Thumbs.db
.user_save.cfg
*.pem
serve_iphone.py

# Scratch / exploration directory (each file already has Godot-side .gdignore)
scratch/

# Godot editor auto-backup directories (timestamped, regenerated per session)
.godot_backup*/

# Python bytecode
__pycache__/
*.pyc

